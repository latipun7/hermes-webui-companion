{
  "$schema": "https://raw.githubusercontent.com/nicepkg/vscode-tauri/main/schemas/config.schema.json",
  "productName": "Hermes WebUI Companion",
  "version": "0.1.0",
  "identifier": "dev.latipun7.hermes-webui-companion",
  "build": {
    "frontendDist": "gui",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hermes WebUI Companion",
        "url": "index.html",
        "width": 172,
        "height": 186,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": true,
        "devtools": true
      },
      {
        "label": "bubbles",
        "title": "",
        "url": "bubbles.html",
        "width": 320,
        "height": 84,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ]
  }
}