#!/usr/bin/env bash
# Pre-commit hook: enforce rustfmt + clippy before every commit.
# Install with: git config core.hooksPath .githooks

set -euo pipefail

echo "[pre-commit] Checking Rust formatting..."
cargo fmt --check --all 2>&1 | sed 's/^/[rustfmt] /'
fmt_exit=$?

if [ $fmt_exit -ne 0 ]; then
  echo ""
  echo "❌ [rustfmt] Formatting check FAILED."
  echo "   Run 'cargo fmt' to fix automatically, then stage again."
  exit 1
fi

echo "[pre-commit] Running Clippy..."
cargo clippy --locked --workspace --all-targets --all-features -- -D warnings 2>&1 | sed 's/^/[clippy] /'
clippy_exit=$?

if [ $clippy_exit -ne 0 ]; then
  echo ""
  echo "❌ [clippy] Clippy check FAILED."
  echo "   Fix the warnings above, then stage again."
  exit 1
fi

echo "✅ [pre-commit] All checks passed — fmt + clippy clean."
